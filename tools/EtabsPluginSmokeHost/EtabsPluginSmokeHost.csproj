<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <EtabsApiPath Condition="'$(EtabsApiPath)' == ''">$(ETABS_API_PATH)</EtabsApiPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\plugins\etabs\BeamGenerator.EtabsPlugin\BeamGenerator.EtabsPlugin.csproj" />
    <Reference Include="ETABSv1">
      <HintPath>$(EtabsApiPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireEtabsApi" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(EtabsApiPath)' == '' Or !Exists('$(EtabsApiPath)')"
      Text="Set EtabsApiPath (or ETABS_API_PATH) to an absolute ETABSv1.dll path from ETABS 22/23."
    />
  </Target>
</Project>

